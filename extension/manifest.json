{
  "manifest_version": 3,
  "name": "טל · מילוי חשבוניות בבן ארי",
  "version": "1.3",
  "description": "ממלא חשבונית מס קבלה בבן ארי לפי תשלום מהאפליקציה. לא מפיק — ההפקה רק בלחיצה שלך על שמור.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://tal373.github.io/tal-business/*"
      ],
      "js": [
        "app.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://wbfbamldcpa.azurewebsites.net/*"
      ],
      "js": [
        "wb.js"
      ],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon128.png"
  }
}